    given-names: Aditya
version: 0.1.0
date-released: "2026-09-13"
license: MIT
repository-code: "https://github.com/pujariaditya/spanmark"
url: "https://huggingface.co/RootAccess4Life/spanmark"
keywords:
  - speech anti-spoofing
  - partial spoof
  - localization
